# Copy to deploy/.env (git-ignored) and fill in. Generate every secret with
#   openssl rand -hex 32
# Hex keeps them safe inside connection URLs. Never commit deploy/.env.

# PostgreSQL superuser (used only by the migrate job).
POSTGRES_PASSWORD=

# Login passwords for the two application roles (at least 24 characters).
VYOM_APP_DB_PASSWORD=
VYOM_SERVICE_DB_PASSWORD=

# Signs console sessions. Shared by the API and the console. At least 32 characters.
VYOM_SESSION_SECRET=

# Password for the fictional demo-pharma accounts created by the `seed` service.
VYOM_DEMO_PASSWORD=

# demo = the deterministic rule engine (no model, no network); live = Vertex AI.
VYOM_AI_MODE=demo

# Live literature sweeps identify themselves to NCBI. Use a team mailbox.
NCBI_TOOL=vyom
NCBI_EMAIL=
NCBI_API_KEY=

# on: /login also offers the fictional sample workspace. off for client data.
VYOM_SAMPLE_WORKSPACE=on
WEB_HOST_PORT=3000
